{
  "name": "rag-backend",
  "version": "1.0.0",
  "description": "NestJS RAG backend with Gemini + pgvector",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed:admin": "npm run build && node dist/auth/seed-admin.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
